# ============================================
# Core
# ============================================
SECRET_KEY=change-me-in-production
DEBUG=False

# ============================================
# Hosts
# ============================================
ALLOWED_HOSTS=vitrin.ir,www.vitrin.ir
CSRF_TRUSTED_ORIGINS=https://vitrin.ir,https://www.vitrin.ir
CORS_ALLOWED_ORIGINS=https://vitrin.ir,https://www.vitrin.ir

# ============================================
# Database & Cache
# ============================================
DATABASE_URL=postgres://user:pass@db:5432/vitrin
REDIS_URL=redis://redis:6379/0
CONN_MAX_AGE=60

# ============================================
# Security
# ============================================
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

# ============================================
# Email
# ============================================
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=noreply@vitrin.ir
EMAIL_HOST_PASSWORD=change-me
DEFAULT_FROM_EMAIL=noreply@vitrin.ir
